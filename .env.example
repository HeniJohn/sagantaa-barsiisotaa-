# Maqaa fayyadamaa fi iyyuu (username/password) bulchaa (admin) fi barsiisaa (teacher).
# Kana .env jedhu keessatti barreessi (faayilli .env kun GitHub irratti hin mul'atu —
# .gitignore keessa jira), ykn Vercel/Netlify irratti Project Settings > Environment
# Variables jalatti maqaa armaan gadii maxxansi.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=changeme123
VITE_TEACHER_USERNAME=teacher
VITE_TEACHER_PASSWORD=changeme456
